DATABASE_URL="file:./dev.db"

# Signs the session cookie. Use a long random string.
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional. Without a key the photo analyser runs in simulation mode so the
# whole flow still works offline. Add a key to use real vision analysis.
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o-mini"
