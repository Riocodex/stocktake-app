{
  "name": "tribe-stocktake",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --port 3111 --hostname 0.0.0.0",
    "app": "npm --prefix mobile start",
    "app:ios": "npm --prefix mobile run ios",
    "app:android": "npm --prefix mobile run android",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "rm -f dev.db dev.db-journal && prisma db push && tsx prisma/seed.ts",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "test:units": "tsx scripts/test-units.ts",
    "test:recipes": "tsx scripts/test-recipes.ts",
    "test:costing": "tsx scripts/test-dish-costing.ts",
    "test:alerts": "tsx scripts/test-cost-alerts.ts",
    "test:availability": "tsx scripts/test-dish-availability.ts",
    "test:dish-wastage": "tsx scripts/test-dish-wastage.ts",
    "test:ordering": "tsx scripts/test-ordering.ts",
    "test:invoice-ai": "tsx scripts/test-invoice-ai.ts",
    "test:invoice-receiving": "tsx scripts/test-invoice-receiving.ts",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.10",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "dotenv": "^17.4.2",
    "postcss": "^8.5.26",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
