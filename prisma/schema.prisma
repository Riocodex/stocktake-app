// TRiBE Stock Take — data model
//
// Note: SQLite (via Prisma) has no native enum support, so role/status style
// fields are stored as strings. The allowed values live in src/lib/constants.ts
// and are the single source of truth for the application layer.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "sqlite"
}

/// A single TRiBE venue. Outlet admins are scoped to exactly one of these.
model Outlet {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  address   String?
  city      String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users       User[]
  stockLevels OutletStock[]
  stockTakes  StockTake[]
  prices      PriceHistory[]
  deliveries  Delivery[]
  wastage     Wastage[]
  transfersOut Transfer[] @relation("TransferFrom")
  transfersIn  Transfer[] @relation("TransferTo")
  stockMovements StockMovement[]

  @@map("outlets")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  /// SUPER_ADMIN sees every outlet; OUTLET_ADMIN is limited to `outletId`.
  role         String    @default("OUTLET_ADMIN")
  outletId     String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  outlet     Outlet?     @relation(fields: [outletId], references: [id], onDelete: SetNull)
  stockTakes StockTake[]
  deliveries Delivery[]
  wastage    Wastage[]
  transfersCreated  Transfer[] @relation("TransferCreatedBy")
  transfersSent     Transfer[] @relation("TransferSentBy")
  transfersReceived Transfer[] @relation("TransferReceivedBy")
  stockMovements    StockMovement[]

  @@index([outletId])
  @@map("users")
}

model Category {
  id        String @id @default(cuid())
  name      String @unique
  sortOrder Int    @default(0)
  /// BAR | KITCHEN | BOTH
  area      String @default("BOTH")

  items InventoryItem[]

  @@map("categories")
}

/// The GLOBAL inventory catalogue: one row per product across the whole group.
/// Outlet-specific quantities and prices live in OutletStock.
model InventoryItem {
  id         String @id @default(cuid())
  sku        String @unique
  name       String
  brand      String?
  categoryId String
  /// Counting unit, e.g. bottle, kg, case, unit.
  unit       String @default("unit")
  packSize   String?
  /// Group-wide reference cost price in EUR.
  referencePrice    Float  @default(0)
  /// Default target stock level, used when an outlet has no override.
  parLevel          Float  @default(0)
  lowStockThreshold Float  @default(0)
  /// Typical quantity received in one supplier delivery of this product.
  supplierPackQty Float?
  /// Comma-separated alternative names, used to match AI-detected labels.
  aliases    String   @default("")
  imageUrl   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category     Category        @relation(fields: [categoryId], references: [id])
  outletStock  OutletStock[]
  lines        StockTakeLine[]
  priceHistory PriceHistory[]
  deliveries   DeliveryLine[]
  wastage      Wastage[]
  transferLines TransferLine[]
  stockMovements StockMovement[]
  recipeLines  DishIngredient[]

  @@index([categoryId])
  @@index([name])
  @@map("inventory_items")
}

/// Current stock position of one catalogue item at one outlet.
model OutletStock {
  id            String    @id @default(cuid())
  outletId      String
  itemId        String
  quantity      Float     @default(0)
  /// Outlet-level price in EUR; falls back to the item reference price.
  unitPrice     Float     @default(0)
  parLevel      Float?
  lastCountedAt DateTime?
  /// Best-before of the current batch at this outlet, set on delivery.
  expiryDate    DateTime?
  updatedAt     DateTime  @updatedAt

  outlet Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([outletId, itemId])
  @@index([itemId])
  @@map("outlet_stock")
}

/// A counting session. Lines start as DRAFT suggestions and are applied to
/// OutletStock only when the session is submitted.
model StockTake {
  id          String    @id @default(cuid())
  reference   String    @unique
  outletId    String
  userId      String
  /// DRAFT | SUBMITTED
  status      String    @default("DRAFT")
  /// BAR | KITCHEN — which side of the venue this count covers.
  area        String    @default("BAR")
  note        String?
  createdAt   DateTime  @default(now())
  submittedAt DateTime?

  outlet Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  user   User            @relation(fields: [userId], references: [id])
  lines  StockTakeLine[]
  photos StockPhoto[]

  @@index([outletId, status])
  @@index([createdAt])
  @@map("stock_takes")
}

model StockTakeLine {
  id          String  @id @default(cuid())
  stockTakeId String
  itemId      String
  photoId     String?
  countedQty  Float   @default(0)
  /// Snapshot of the outlet position at the time the line was created.
  previousQty   Float @default(0)
  unitPrice     Float @default(0)
  previousPrice Float @default(0)
  /// AI | MANUAL
  source     String  @default("AI")
  /// 0..1 model confidence, null for manual lines.
  confidence Float?
  /// The raw label the vision model produced, kept for auditing.
  aiLabel    String?
  createdAt  DateTime @default(now())

  stockTake StockTake     @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  photo     StockPhoto?   @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@unique([stockTakeId, itemId])
  @@index([itemId])
  @@map("stock_take_lines")
}

model StockPhoto {
  id          String @id @default(cuid())
  stockTakeId String
  fileName    String
  /// Public URL under /uploads.
  url         String
  /// PENDING | ANALYZING | ANALYZED | FAILED
  status      String @default("PENDING")
  /// Which analyser produced the result, e.g. openai:gpt-4o-mini or simulated.
  provider    String?
  /// Raw JSON returned by the analyser, for auditing.
  rawResponse String?
  detectedCount Int      @default(0)
  error         String?
  createdAt     DateTime @default(now())
  analyzedAt    DateTime?

  stockTake  StockTake       @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  lines      StockTakeLine[]
  detections PhotoDetection[]

  @@index([stockTakeId])
  @@map("stock_photos")
}

/// Every individual thing the model reported in a photo, kept whether or not
/// it could be matched to the catalogue. Unmatched rows are surfaced in the UI
/// so a human can map them instead of the reading being silently dropped.
model PhotoDetection {
  id          String  @id @default(cuid())
  photoId     String
  stockTakeId String
  label       String
  quantity    Float
  unitPrice   Float?
  unit        String?
  confidence  Float   @default(0)
  /// SKU the model claimed, before verification.
  sku         String?
  /// MATCHED | UNMATCHED | DISMISSED
  status        String   @default("UNMATCHED")
  matchedItemId String?
  matchReason   String?
  createdAt     DateTime @default(now())

  photo StockPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([stockTakeId, status])
  @@map("photo_detections")
}

/// Append-only price trail so price movements are explainable.
model PriceHistory {
  id            String   @id @default(cuid())
  itemId        String
  outletId      String?
  price         Float
  previousPrice Float?
  /// AI | MANUAL | SEED
  source        String
  createdAt     DateTime @default(now())

  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  outlet Outlet?       @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt])
  @@map("price_history")
}

/// A supplier delivery: incoming stock recorded without a full count.
model Delivery {
  id        String   @id @default(cuid())
  outletId  String
  userId    String
  note      String?
  createdAt DateTime @default(now())

  outlet Outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id])
  lines  DeliveryLine[]

  @@index([outletId, createdAt])
  @@map("deliveries")
}

model DeliveryLine {
  id         String    @id @default(cuid())
  deliveryId String
  itemId     String
  quantity   Float
  unitPrice  Float?
  expiryDate DateTime?
  createdAt  DateTime  @default(now())

  delivery Delivery      @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  item     InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("delivery_lines")
}

/// Recorded wastage. ITEM deducts OutletStock; DISH records financial loss only (Option B).
model Wastage {
  id         String   @id @default(cuid())
  outletId   String
  /// Set for ITEM wastage; null for DISH.
  itemId     String?
  /// Set for DISH wastage; null for ITEM.
  dishId     String?
  /// Snapshot of item/dish name at recording time (history stays readable if renamed).
  targetName String?
  /// ITEM | DISH
  targetType String   @default("ITEM")
  quantity   Float
  /// Item stock unit, or "portion" for dish wastage.
  unit       String
  /// EUR cost per unit/portion snapshotted at recording time.
  unitCost   Float
  /// SPOILED | EXPIRED | DAMAGED | PREPARATION_WASTE | OVERPRODUCTION | STAFF_ERROR | OTHER
  reason     String
  note       String?
  /// Optional photo that identified this wastage (same URL may appear on several rows).
  imageUrl   String?
  userId     String
  createdAt  DateTime @default(now())

  outlet Outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade)
  item   InventoryItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  dish   Dish?          @relation(fields: [dishId], references: [id], onDelete: SetNull)
  user   User           @relation(fields: [userId], references: [id])

  @@index([outletId, createdAt])
  @@index([itemId, createdAt])
  @@index([dishId, createdAt])
  @@index([targetType, createdAt])
  @@index([reason])
  @@map("wastage")
}

/// Outlet-to-outlet stock transfer. Stock moves only on SENT / RECEIVED.
model Transfer {
  id            String    @id @default(cuid())
  reference     String    @unique
  fromOutletId  String
  toOutletId    String
  /// DRAFT | SENT | RECEIVED | CANCELLED
  status        String    @default("DRAFT")
  note          String?
  /// Optional photo used when drafting (AI-assisted create).
  imageUrl      String?
  createdById   String
  sentById      String?
  receivedById  String?
  createdAt     DateTime  @default(now())
  sentAt        DateTime?
  receivedAt    DateTime?
  cancelledAt   DateTime?

  fromOutlet  Outlet @relation("TransferFrom", fields: [fromOutletId], references: [id], onDelete: Cascade)
  toOutlet    Outlet @relation("TransferTo", fields: [toOutletId], references: [id], onDelete: Cascade)
  createdBy   User   @relation("TransferCreatedBy", fields: [createdById], references: [id])
  sentBy      User?  @relation("TransferSentBy", fields: [sentById], references: [id])
  receivedBy  User?  @relation("TransferReceivedBy", fields: [receivedById], references: [id])
  lines       TransferLine[]

  @@index([fromOutletId, status, createdAt])
  @@index([toOutletId, status, createdAt])
  @@index([status, createdAt])
  @@map("transfers")
}

model TransferLine {
  id               String  @id @default(cuid())
  transferId       String
  itemId           String
  /// Catalogue unit snapshotted at create/send time.
  unit             String
  /// Quantity leaving the source (set at draft, locked at send).
  sentQty          Float
  /// Quantity confirmed at destination; null until RECEIVED.
  receivedQty      Float?
  /// Required when receivedQty differs from sentQty.
  discrepancyNote  String?
  createdAt        DateTime @default(now())

  transfer Transfer     @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item     InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([transferId, itemId])
  @@index([itemId])
  @@map("transfer_lines")
}

/// Singleton-style app settings (one row, id = "default").
model AppSettings {
  id                      String   @id @default("default")
  /// Food-cost % at/above this → Warning (below Critical).
  foodCostWarningPercent  Float    @default(30)
  /// Food-cost % at/above this → Critical.
  foodCostCriticalPercent Float    @default(35)
  updatedAt               DateTime @updatedAt

  @@map("app_settings")
}

/// Prepared menu product made from physical Items (recipes come later).
/// Never has OutletStock and never appears in stock takes / deliveries / transfers.
model Dish {
  id           String   @id @default(cuid())
  name         String
  /// Menu section label, e.g. Smoothies, Mains, Cocktails.
  category     String
  description  String?
  imageUrl     String?
  /// Selling / retail price in EUR.
  sellingPrice Float    @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ingredients DishIngredient[]
  wastage     Wastage[]

  @@index([category, name])
  @@index([isActive, name])
  @@index([name])
  @@map("dishes")
}

/// One physical Item quantity required to prepare a single portion of a Dish.
/// Quantities are stored in the recipe `unit`; convert to the item's stock unit
/// via `src/lib/units.ts` for costing / availability (Steps 7 and 9).
model DishIngredient {
  id        String   @id @default(cuid())
  dishId    String
  itemId    String
  /// Amount of the item needed for one dish portion, in `unit`.
  quantity  Float
  /// Recipe unit (may differ from InventoryItem.unit when convertible).
  unit      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dish Dish          @relation(fields: [dishId], references: [id], onDelete: Cascade)
  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([dishId, itemId])
  @@index([itemId])
  @@map("dish_ingredients")
}

/// Append-only audit of physical inventory quantity changes (items only).
model StockMovement {
  id              String   @id @default(cuid())
  outletId        String
  itemId          String
  /// STOCK_TAKE_ADJUSTMENT | DELIVERY | WASTAGE | TRANSFER_OUT | TRANSFER_IN | MANUAL_ADJUSTMENT
  movementType    String
  /// Signed delta: positive = stock in, negative = stock out.
  quantityChange  Float
  unit            String
  /// Null when historical backfill cannot verify balances.
  quantityBefore  Float?
  quantityAfter   Float?
  performedById   String?
  /// STOCK_TAKE | STOCK_TAKE_LINE | DELIVERY | DELIVERY_LINE | WASTAGE | TRANSFER | TRANSFER_LINE
  referenceType   String?
  referenceId     String?
  note            String?
  createdAt       DateTime @default(now())

  outlet      Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  performedBy User?         @relation(fields: [performedById], references: [id], onDelete: SetNull)

  /// Prevents duplicate live writes / repeated backfills for the same event.
  @@unique([referenceType, referenceId, movementType, itemId])
  @@index([outletId, createdAt])
  @@index([itemId, createdAt])
  @@index([movementType, createdAt])
  @@index([performedById])
  @@map("stock_movements")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  outletId  String?
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("activity_log")
}
